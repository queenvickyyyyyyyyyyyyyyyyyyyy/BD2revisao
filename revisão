select h.hospede_id, h.nome,
sum(r.preco) as preco_total
from Hospedes h
inner join Reservas r on h.hospede_id = r.hospede_id
group by h.hospede_id, h.nome;

select hospede_id, 
sum(preco) as preco_total
from Reservas r
group by hospede_id
having sum(preco) > 2000;

select quarto_id,
avg(preco) as preco_total
from Reservas r
group by quarto_id;



















